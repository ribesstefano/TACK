Bootstrap: docker
From: continuumio/miniconda3:23.10.0-1

%post
    conda install -y python=3.11.5
    conda install -y mkl=2023.1.0 pytorch==2.1.0 torchvision==0.16.0 torchaudio==2.1.0 pytorch-cuda=11.8 -c pytorch -c nvidia
    conda install -y numpy=1.26.4

    pip install jupyterlab datasets huggingface_hub matplotlib seaborn scikit-learn python-dotenv
    pip install torch_geometric==2.5.1 rdkit==2023.9.2 pandas==2.1.1 toml==0.10.2 wandb
    pip install https://data.pyg.org/whl/torch-2.1.0%2Bcu118/torch_scatter-2.1.2%2Bpt21cu118-cp311-cp311-linux_x86_64.whl

    conda clean --all -y
    pip cache purge

%environment
    export PATH=/opt/conda/bin:$PATH
